      "example": "Airbus"
    },
    {
      "id": "type",
      "name": "Type (ICAO type designator)",
      "type": "text",
      "max": 8,
      "case": "upper",
      "to": "instrument",
      "example": "A320"
    },
    {
      "id": "msn",
      "name": "Manufacturer serial number",
      "type": "text",
      "max": 16,
      "case": "upper",
      "to": "instrument",
      "example": "1234"
    }
  ],
  "note": "A single aircraft by manufacturer, ICAO type designator and manufacturer serial number (a registration mark can change; the serial number does not)."
