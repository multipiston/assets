{
  "family": "machines.aircraft",
  "name": "One aircraft by manufacturer serial number",
  "symbol": "AIRCRFT",
  "icon": "icons/recipes/aircraft.svg",
  "kind": "Unique",
  "source": "spec:msn",
  "unit": "item",
  "instrument": "{manufacturer}:{type}:{msn}",
